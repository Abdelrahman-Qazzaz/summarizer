# Service token for the `dev_fetcher` config (see doppler.yaml). `npm run
# dev:fetcher` sources this file before `doppler run`, so the token that fetches
# this service's secrets lives with this service.
DOPPLER_TOKEN=

# Doppler (config dev_fetcher) is the source of truth for everything below —
# the fetcher reads them straight from the ambient environment and logs a red
# warning when Doppler is not the one injecting them.
MQ_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Where this fetcher reaches the backend API.
API_BASE_URL=http://localhost:3001
