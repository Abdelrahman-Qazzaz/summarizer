{
  "name": "summarizer-server",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.14.1",
  "scripts": {
    "dev": "npm run --silent doppler -- concurrently -k -n api,worker \"tsx watch --inspect=9229 api/index.ts\" \"tsx watch --inspect=9230 transcribe-service/index.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db": "npm run --silent doppler -- drizzle-kit push",
    "test": "npm run --silent doppler -- vitest run",
    "test:watch": "npm run --silent doppler -- vitest",
    "doppler": "set -a; [ -f .env ] && . ./.env; set +a; exec doppler run --"
  },
  "dependencies": {
    "@deepgram/sdk": "^5.7.0",
    "@hono/node-server": "1.19.2",
    "@openrouter/sdk": "^0.12.79",
    "@supabase/supabase-js": "2.103.0",
    "@upstash/redis": "1.38.0",
    "@workos-inc/node": "9.1.0",
    "amqplib": "1.0.3",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.12",
    "hono-rate-limiter": "0.5.3",
    "postgres": "^3.4.9",
    "socket.io": "4.8.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/amqplib": "0.10.8",
    "@types/node": "25.6.0",
    "concurrently": "9.2.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "tsx": "4.20.5",
    "typescript": "5.7.3",
    "typescript-eslint": "8.57.0",
    "vitest": "4.1.5"
  }
}
