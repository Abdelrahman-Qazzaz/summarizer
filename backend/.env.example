# Service token for the `dev_backend` config (see doppler.yaml). The npm scripts
# source this file before `doppler run`, so the token that fetches this service's
# secrets lives with this service — nothing is read from a parent directory.
DOPPLER_TOKEN=

# Base (API + worker)
# Supabase Postgres connection string (Project Settings → Database → Connection string).
# Prefer a pooler URI — host aws-<n>-<region>.pooler.supabase.com, user
# postgres.<project-ref> — since it resolves over IPv4 and works everywhere:
#   - Session pooler  (port 5432): use for drizzle-kit push / migrations (DDL).
#   - Transaction pooler (port 6543): fine for the app at runtime.
# The direct connection (db.<project-ref>.supabase.co:5432) is IPv6-only and
# will hang in IPv4-only environments (e.g. this devcontainer).
DATABASE_URL=
MQ_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=
# Speech-to-text. Separate from OpenRouter: transcription runs on Deepgram,
# which takes a signed bucket URL and returns a full transcript for audio of
# any length. Key from console.deepgram.com → API Keys.
DEEPGRAM_API_KEY=
NODE_ENV=development

# API only. Doppler (config dev_backend) is the source of truth for these —
# this file is only a fallback, and the app logs a red warning when it is used.
# Use localhost everywhere in dev — not 127.0.0.1 — so cookies work with Socket.IO.
SESSION_SECRET=
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Where the browser reaches the client, and where WorkOS/the fetcher reach this
# API. Both are required — there is no localhost default.
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:3001
PORT=3001
WS_PORT=4000
UPSTASH_REDIS_REST_URL="https://glad-tapir-146085.upstash.io"
UPSTASH_REDIS_REST_TOKEN="********"

# Worker only
# Nothing. The worker runs no HTTP server (nothing dials it) and consumes a
# single queue, so it needs no configuration beyond the base vars above —
# scaling it is purely a replica count.
